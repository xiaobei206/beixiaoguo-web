#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

APP_BIN="/usr/bin/beixiaoguo"
WATCHDOG_SCRIPT="/usr/bin/beixiaoguo-watchdog.sh"

start_service() {
  if [ ! -x "$APP_BIN" ]; then
    logger -t beixiaoguo "ERROR: executable missing: $APP_BIN"
    return 1
  fi
  if [ ! -x "$WATCHDOG_SCRIPT" ]; then
    logger -t beixiaoguo "ERROR: watchdog script missing: $WATCHDOG_SCRIPT"
    return 1
  fi

  # The image-only disk cache is evictable, capped at 4 GiB by default,
  # and never preallocated. Runtime settings live in a small JSON file.
  if ! mkdir -p /opt/beixiaoguo/cache/images; then
    logger -t beixiaoguo "WARNING: persistent image cache directory is unavailable; RAM cache remains enabled"
  fi

  # Main HTTP service. Retry forever; every runtime log goes to OpenWrt's
  # bounded RAM log buffer instead of growing a log file.
  procd_open_instance app
  procd_set_param command "$APP_BIN"
  procd_set_param env BEIXIAOGUO_IMAGE_CACHE_DIR=/opt/beixiaoguo/cache/images BEIXIAOGUO_SETTINGS_PATH=/opt/beixiaoguo/settings.json
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param term_timeout 10
  procd_close_instance

  # Lightweight local health checker. It asks procd to signal only the app
  # instance; procd then respawns the app without restarting the watchdog.
  procd_open_instance watchdog
  procd_set_param command /bin/sh "$WATCHDOG_SCRIPT"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param term_timeout 5
  procd_close_instance
}
